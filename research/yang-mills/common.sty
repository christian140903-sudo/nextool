% Shared layout for the Yang–Mills research documents (spec.tex, reports/*.tex).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{common}[2026/09/24 Yang-Mills research documents]
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage[english]{babel}
\RequirePackage{microtype}
\RequirePackage[a4paper,margin=2.25cm,headheight=14pt]{geometry}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{array,booktabs,longtable,tabularx}
\RequirePackage[dvipsnames,table]{xcolor}
\RequirePackage{enumitem}
\RequirePackage{csquotes}
\RequirePackage{seqsplit}
\RequirePackage{fancyhdr}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{url}


% ------------------------------------------------------------------ layout
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.12}
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}
\setlist{itemsep=2pt,topsep=3pt}

% ------------------------------------------------------------------ badges
\definecolor{stVERIFIED}{HTML}{D6EFDD}
\definecolor{stSTANDARD}{HTML}{DCE8F7}
\definecolor{stPARTIAL}{HTML}{FBEBC8}
\definecolor{stOPEN}{HTML}{F9D9C4}
\definecolor{stFALSE}{HTML}{F4C7C7}
\definecolor{stHEURISTIC}{HTML}{E6E6E6}
\definecolor{stNUMERICAL}{HTML}{E8DDF3}
\definecolor{stPREPRINT}{HTML}{EDEDED}
\definecolor{stCLOSED}{HTML}{C9EBD3}
\definecolor{clNORMATIVE}{HTML}{DCE8F7}
\definecolor{clDERIVED}{HTML}{E8DDF3}
\definecolor{clPROCEDURAL}{HTML}{FBEBC8}
\definecolor{clGOVERNANCE}{HTML}{E6E6E6}
\newcommand{\badge}[2]{{\setlength{\fboxsep}{1.5pt}\colorbox{#1}{\strut\scriptsize\sffamily #2}}}
\newcommand{\statusbadge}[1]{\badge{st#1}{#1}}
\newcommand{\classbadge}[1]{\badge{cl#1}{#1}}

\newtcolorbox{keybox}[1][]{breakable,enhanced,colback=black!3,colframe=black!55,
  boxrule=0.5pt,arc=1.5pt,left=6pt,right=6pt,top=4pt,bottom=4pt,fonttitle=\sffamily\bfseries,#1}
% ------------------------------------------------------------------ maths
\theoremstyle{definition}
\newtheorem{definition}{Definition}[section]
\newtheorem{statement}[definition]{Statement}
\theoremstyle{plain}
\newtheorem{lemma}[definition]{Lemma}
\newtheorem{importedtheorem}[definition]{Imported theorem}
\theoremstyle{remark}
\newtheorem{remark}[definition]{Remark}
\newtheorem{proposal}[definition]{Proposal}
\theoremstyle{plain}
\newtheorem{proposition}[definition]{Proposition}

\newcommand{\R}{\mathbb R}
\newcommand{\C}{\mathbb C}
\newcommand{\cT}{\mathcal T}
\newcommand{\cH}{\mathcal H}
\newcommand{\cO}{\mathcal O}
\newcommand{\g}{\mathfrak g}
\DeclareMathOperator{\Tr}{Tr}
\DeclareMathOperator{\supp}{supp}
\DeclareMathOperator{\Lie}{Lie}

\pagestyle{fancy}
\renewcommand{\headrulewidth}{0.3pt}
\endinput
