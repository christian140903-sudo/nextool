# Sicherheits-Header fuer nextool.app (Cloudflare Pages wendet _headers auf pages.dev
# und auf Custom Domains an; _redirects wird vor _headers ausgewertet).
# CSP: nur eigene Quellen; Skripte ganz aus (die Seiten haben keine), keine Inline-Styles.
# Der Linter (npm test) prueft diese Datei: kein 'unsafe-*', keine fremden Hosts,
# frame-ancestors 'none', HSTS ohne preload.
/*
  Content-Security-Policy: default-src 'self'; script-src 'none'; object-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin

# Schriften aendern sich nur mit neuem Dateinamen.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
