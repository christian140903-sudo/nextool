#!/bin/sh
# soul — Zeiger auf die Maschine; die Logik lebt in core/cli.py (ARCHITEKTUR 5.11).
# POSIX sh ohne Mac-Werkzeuge: läuft auf jedem Unix mit python3 (oder python) auf dem PATH.
SOUL_BIN=$(cd "$(dirname "$0")" && pwd)
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$SOUL_BIN/../core/cli.py" "$@"
fi
exec python "$SOUL_BIN/../core/cli.py" "$@"
