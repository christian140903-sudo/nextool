# Rohartefakte liegen als komprimiertes Archiv unter belege/, nicht als Einzeldateien.
# Der Roh-Artefakt-Zwang bleibt erfüllt: jede Zahl ist aus den Archiven nachrechenbar.
ergebnisse/*/raw/
ergebnisse/*.log
# Fehlversuche (abgebrochene Aufrufe) liegen ebenfalls nur im Beleg-Archiv.
ergebnisse/*/fehlversuche/
# Bytecode gehoert nicht ins Archiv.
__pycache__/
